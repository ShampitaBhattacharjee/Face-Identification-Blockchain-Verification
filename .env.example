# ---- Reverse-image search ------------------------------------------------
# Free key (100 searches/month): https://www.searchapi.io or https://serpapi.com
SERPAPI_KEY=
# Optional second provider: Azure "Bing Search v7" resource key
BING_API_KEY=
# Optional: force a temporary image host (freeimage | tmpfiles | litterbox | 0x0)
IMAGE_HOST=

# ---- Blockchain ------------------------------------------------------------
# sepolia (Ethereum Sepolia testnet) or amoy (Polygon Amoy testnet)
CHAIN=sepolia
# RPC endpoint (e.g. https://gateway.tenderly.co/public/sepolia or an Alchemy/Infura URL)
RPC_URL=https://gateway.tenderly.co/public/sepolia
# Private key of a TESTNET-ONLY wallet (0x-prefixed). Fund it at:
#   Sepolia: https://cloud.google.com/application/web3/faucet/ethereum/sepolia
#   Amoy:    https://faucet.polygon.technology
PRIVATE_KEY=
# Optional: override the address saved in deployments/<chain>.json
CONTRACT_ADDRESS=
